@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads       REQUIRED)
find_dependency(Lua           REQUIRED)
find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(grpc          CONFIG REQUIRED)
find_dependency(yaml-cpp      CONFIG REQUIRED)
find_dependency(sol2          CONFIG REQUIRED)
find_dependency(instrument-data CONFIG REQUIRED)
find_dependency(instrument-log CONFIG REQUIRED)
find_dependency(instrument-call-stack CONFIG REQUIRED)
find_dependency(instrument-plugin-api CONFIG REQUIRED)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/instrument-script-server-targets.cmake")

# Set include directories
set(InstrumentServer_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_PREFIX@/include")

check_required_components(instrument-script-server)
check_required_components(instrument-worker)
check_required_components(template-expander)
check_required_components(validate-instrument-api)
check_required_components(validate-instrument-config)
check_required_components(validate-quantum-dot-config)
check_required_components(generate-instrument-config)
