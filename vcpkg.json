{
  "name": "instrument-script-server",
  "version-string": "2.0.17",
  "description": "a modular, process-isolated system for controlling scientific instruments for FAlCon use",
  "builtin-baseline": "9942fb5f996ea431c5ed8fb8d2a53f31d08df62e",
  "dependencies": [
    "grpc",
    "lua",
    "nlohmann-json",
    "sol2",
    "gtest",
    "grpc",
    "yaml-cpp",
    "boost-interprocess",
    "boost-date-time",
    "cxxopts",
    "yaml-config-validator",
    {
      "name": "instrument-data",
      "version>=": "1.1.8"
    },
    {
      "name": "instrument-plugin-api",
      "version>=": "2.0.7",
      "features": [
        "host",
        "plugin"
      ]
    },
    {
      "name": "instrument-log",
      "version>=": "1.0.5"
    },
    {
      "name": "instrument-call-stack",
      "version>=": "1.0.6",
      "features": [
        "lua"
      ]
    }
  ]
}
